# Copy to selfhost/.env and replace every placeholder before deploy.

DOMAIN=nqtn.dev
CERTBOT_EMAIL=certbot@example.com
CERTBOT_DOMAIN=nqtn.dev
CERTBOT_WILDCARD_DOMAIN="*.nqtn.dev"

TZ=Asia/Ho_Chi_Minh
PUID=1000
PGID=1000

# Host directory for logs and data that are easier to back up as files.
# scripts/bootstrap-vps.sh creates /var/lib/selfhost for the sudo user.
ROOT_DATA_PATH=/var/lib/selfhost

# Passwords and keys are left empty on purpose. Sample values are flagged as leaked secrets.
# Set them in GitHub Secrets. 16+ letters and digits only (symbols break Redis and database URLs).
POSTGRES_USER=airflow
POSTGRES_PASSWORD=
POSTGRES_DB=airflow

REDIS_PASSWORD=

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

PGADMIN_DEFAULT_EMAIL=pgadmin@example.com
PGADMIN_DEFAULT_PASSWORD=

# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FERNET_KEY=

AIRFLOW_IMAGE_NAME=apache/airflow:3.0.6
AIRFLOW_UID=50000
AIRFLOW_WWW_USER_USERNAME=admin
AIRFLOW_WWW_USER_PASSWORD=
AIRFLOW_LOAD_EXAMPLES=false

# openssl rand -hex 32
HOMARR_SECRET_ENCRYPTION_KEY=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
