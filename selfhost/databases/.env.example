# Databases stack environment example
AIRFLOW_UID=1000
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=airflow

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET_NAME=binance

# Optional runtime extras
NEWSAPI_KEY=replace_if_used

# Airflow local admin bootstrap
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=change_me

# Postgres backup scheduler (daily by default)
POSTGRES_BACKUP_SCHEDULE=@daily
POSTGRES_BACKUP_KEEP_DAYS=30
POSTGRES_BACKUP_KEEP_WEEKS=8
POSTGRES_BACKUP_KEEP_MONTHS=6
