# Management stack environment example

# Bootstrap credentials for creating the Keycloak DB/user in existing Postgres
KEYCLOAK_BOOTSTRAP_DB_USER=airflow
KEYCLOAK_BOOTSTRAP_DB_PASSWORD=change_me

# Keycloak runtime database settings (Option A: existing Postgres server)
KEYCLOAK_DB_HOST=postgres
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change_me

# Keycloak admin bootstrap
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me
KEYCLOAK_HOSTNAME=keycloak.nqtn.dev
